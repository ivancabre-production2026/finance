# Copiá este archivo a secrets.toml para probar localmente con contraseña/Postgres,
# o pegá este mismo contenido (con tus valores reales) en Streamlit Community Cloud
# cuando despliegues: Settings → Secrets.

APP_PASSWORD = "elegí-una-contraseña-acá"

[connections.postgres]
url = "postgresql://usuario:password@host/nombre_db"
